{
  "name": "@knowdrive/mcp",
  "version": "0.1.3",
  "description": "1-click MCP server for KnowDrive — run `npx -y @knowdrive/mcp` to give any MCP client (Claude Desktop, Claude Code, Cursor) memory backed by your KnowDrive KnowDB.",
  "type": "module",
  "bin": {
    "knowdrive-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowdrive",
    "memory",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowdrive/knowdrive-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
