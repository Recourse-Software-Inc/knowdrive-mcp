{
  "name": "@knowdrive/mcp",
  "version": "0.1.7",
  "mcpName": "ai.knowdrive/knowdrive-mcp",
  "description": "Private, multimodal knowledge store for agents: hybrid search over your docs, images, audio and video with cited, provenance-backed results. `npx -y @knowdrive/mcp` bridges any stdio MCP client to the hosted KnowDrive server.",
  "type": "module",
  "bin": {
    "knowdrive-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowdrive",
    "memory",
    "claude",
    "knowledge-base",
    "semantic-search",
    "hybrid-search",
    "rag",
    "citations",
    "multimodal"
  ],
  "license": "MIT",
  "homepage": "https://knowdrive.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recourse-Software-Inc/knowdrive-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Recourse-Software-Inc/knowdrive-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
